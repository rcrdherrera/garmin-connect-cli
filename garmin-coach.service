[Unit]
Description=GarminCoach FastAPI server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ricardo
Group=ricardo
WorkingDirectory=/opt/garmin-connect-cli
EnvironmentFile=/opt/garmin-connect-cli/.env
ExecStart=/home/ricardo/.local/bin/uv run python server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=garmin-coach

[Install]
WantedBy=multi-user.target
